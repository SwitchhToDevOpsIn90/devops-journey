// Session 45: Jenkins builds, tests, scans and pushes; GitHub Actions deploys the digest.
pipeline {
    agent none

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(name: 'HAND_OFF', defaultValue: false,
            description: 'After the push, ask GitHub Actions to deploy this digest. The production approval is still required there.')
    }

    environment {
        APP_DIR = 'session22-dockerfile'
        IMAGE = 'dockerapp'
        AWS_DEFAULT_REGION = 'eu-north-1'
        ECR_REPO_NAME = 'flask-docker-app'
        PUSH_ROLE_NAME = 'jenkins-ecr-push'
        GH_REPO = 'SwitchhToDevOpsIn90/devops-journey'
        TRIVY = 'aquasec/trivy:0.76.2'
    }

    stages {
        stage('Test') {
            agent { label 'docker-agent' }
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/pip install --quiet -r ${APP_DIR}/requirements.txt -r ${APP_DIR}/requirements-dev.txt
                    cd ${APP_DIR} && ../.venv/bin/python -m pytest -q --junitxml=../test-results.xml
                '''
            }
            post { always { junit allowEmptyResults: true, testResults: 'test-results.xml' } }
        }
        stage('Build (linux/amd64)') {
            agent { label 'docker-builder' }
            steps {
                script { env.TAG = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim() }
                sh '''
                    docker build --platform linux/amd64 -t ${IMAGE}:${TAG} ${APP_DIR}
                    ARCH=$(docker image inspect -f '{{.Architecture}}' ${IMAGE}:${TAG})
                    echo "built ${IMAGE}:${TAG} arch=${ARCH}"
                    test "$ARCH" = amd64
                '''
            }
        }
        stage('Smoke test (emulated amd64)') {
            agent { label 'docker-builder' }
            options { skipDefaultCheckout() }
            steps {
                sh '''
                    docker run -d --platform linux/amd64 --name smoke-${BUILD_NUMBER} -p 15000:5000 ${IMAGE}:${TAG}
                    curl -sf --retry 30 --retry-connrefused --retry-delay 1 http://docker:15000/ | tee smoke.txt
                    grep -q "Flask running" smoke.txt
                '''
            }
            post { always { sh 'docker rm -f smoke-${BUILD_NUMBER} || true' } }
        }
        stage('Scan') {
            agent { label 'docker-builder' }
            options { skipDefaultCheckout() }
            steps {
                sh '''
                    docker save ${IMAGE}:${TAG} | docker run -i --rm --entrypoint sh ${TRIVY} -c \
                      'cat > /tmp/image.tar && trivy image --quiet --input /tmp/image.tar --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1'
                '''
            }
        }
        stage('Push to ECR (assumed role)') {
            agent { label 'docker-builder' }
            options { skipDefaultCheckout() }
            steps {
                withCredentials([usernamePassword(credentialsId: 'aws-jenkins-handoff',
                                                  usernameVariable: 'AWS_ACCESS_KEY_ID',
                                                  passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                    sh '''
                        set +x
                        set -e
                        export DOCKER_CONFIG=$(mktemp -d)
                        trap 'rm -rf "$DOCKER_CONFIG"' EXIT
                        ACCOUNT=$(aws sts get-caller-identity --query Account --output text)
                        set -- $(aws sts assume-role --role-arn arn:aws:iam::${ACCOUNT}:role/${PUSH_ROLE_NAME} \
                                   --role-session-name jenkins-${BUILD_NUMBER} --duration-seconds 900 \
                                   --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' --output text)
                        export AWS_ACCESS_KEY_ID=$1 AWS_SECRET_ACCESS_KEY=$2 AWS_SESSION_TOKEN=$3
                        echo "acting as: $(aws sts get-caller-identity --query Arn --output text | sed 's/::[0-9]*:/::<ACCOUNT_ID>:/')"
                        REGISTRY=${ACCOUNT}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com
                        aws ecr get-login-password | docker login --username AWS --password-stdin ${REGISTRY} >/dev/null
                        docker tag ${IMAGE}:${TAG} ${REGISTRY}/${ECR_REPO_NAME}:jenkins-${TAG}
                        docker push -q ${REGISTRY}/${ECR_REPO_NAME}:jenkins-${TAG} >/dev/null
                        aws ecr describe-images --repository-name ${ECR_REPO_NAME} --image-ids imageTag=jenkins-${TAG} \
                          --query 'imageDetails[0].imageDigest' --output text > digest.txt
                        echo "IN ECR: jenkins-${TAG} $(cat digest.txt)"
                    '''
                }
                script { env.DIGEST = readFile('digest.txt').trim() }
            }
        }
        stage('Hand off to GitHub Actions') {
            when { expression { params.HAND_OFF } }
            agent { label 'docker-builder' }
            options { skipDefaultCheckout() }
            steps {
                withCredentials([string(credentialsId: 'gh-actions-dispatch', variable: 'GH_TOKEN')]) {
                    sh '''
                        set +x
                        BODY=$(printf '{"ref":"main","inputs":{"image_digest":"%s","source":"jenkins-%s"}}' "${DIGEST}" "${BUILD_NUMBER}")
                        CODE=$(curl -s -o /tmp/dispatch.out -w '%{http_code}' -X POST \
                          -H "Authorization: Bearer ${GH_TOKEN}" \
                          -H "Accept: application/vnd.github+json" \
                          -H "X-GitHub-Api-Version: 2022-11-28" \
                          -d "${BODY}" \
                          https://api.github.com/repos/${GH_REPO}/actions/workflows/deploy.yml/dispatches)
                        echo "GitHub answered HTTP ${CODE} for digest ${DIGEST} (the deploy still waits for approval)"
                        case "${CODE}" in 200|204) ;; *) cat /tmp/dispatch.out; exit 1 ;; esac
                    '''
                }
            }
        }
    }
}
